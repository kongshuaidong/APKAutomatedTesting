# 复制此文件为 .env（在同级目录），填入实际值后自动生效
# .env 已被 dotenv 加载，不要提交到 git

# ── OpenAI（用于 nlp 模块的自然语言解析）─────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# ── scrcpy（可选，用于投屏调试）──────────────────────────────────────
SCRCPY_PATH=scrcpy

# ── 飞书自建应用机器人（跑完 run_apk_tests.py 自动私聊推送汇总卡片）──
# 1. 前往 https://open.feishu.cn 创建自建应用
# 2. "权限管理" 开通：im:message 和 im:message:send_as_bot
# 3. "版本管理与发布" 创建版本并发布（个人使用可选审核类型：无需审核）
# 4. 填入下方 App ID 和 App Secret
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 接收对象：默认用邮箱最省事；也可换成 open_id / user_id / union_id / phone
# 私聊自己的话填自己的飞书注册邮箱
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=email
